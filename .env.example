# Common
NODE_ENV=production
PORT=3000
LOG_FORMAT=tskv
CORS_ORIGINS=http://localhost

# Backend database selector
DATABASE_DRIVER=postgres

# PostgreSQL (used by backend and database container)
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=prac
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Optional single URL for non-docker backend start
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/prac

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Compose runtime
NGINX_PORT=80
PGADMIN_PORT=8080
GHCR_OWNER=your-github-username
IMAGE_TAG=latest
